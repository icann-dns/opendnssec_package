From: =?utf-8?q?Ond=C5=99ej_Sur=C3=BD?= <ondrej@sury.org>
Date: Sun, 6 Nov 2016 22:32:20 +0100
Subject: Fix OpenSSL 1.1.0 Support

---
 m4/acx_ssl.m4                  | 2 +-
 signer/src/wire/tsig-openssl.c | 5 ++---
 2 files changed, 3 insertions(+), 4 deletions(-)

diff --git a/m4/acx_ssl.m4 b/m4/acx_ssl.m4
index 1dc6e40..d04d851 100644
--- a/m4/acx_ssl.m4
+++ b/m4/acx_ssl.m4
@@ -35,7 +35,7 @@ AC_DEFUN([ACX_SSL], [
             if test x_$ssldir = x_/usr/sfw; then
                 SSL_LIBS="$SSL_LIBS -R$ssldir/lib";
             fi
-            AC_CHECK_LIB(crypto, HMAC_CTX_init,, [
+            AC_CHECK_LIB(crypto, HMAC_CTX_new,, [
                     AC_MSG_ERROR([OpenSSL found in $ssldir, but version 0.9.7 or higher is required])
             ])
             AC_CHECK_FUNCS([EVP_sha1 EVP_sha256])
diff --git a/signer/src/wire/tsig-openssl.c b/signer/src/wire/tsig-openssl.c
index 5d5bce8..09d7b0c 100644
--- a/signer/src/wire/tsig-openssl.c
+++ b/signer/src/wire/tsig-openssl.c
@@ -126,7 +126,7 @@ static void
 cleanup_context(void *data)
 {
     HMAC_CTX* context = (HMAC_CTX*) data;
-    HMAC_CTX_cleanup(context);
+    HMAC_CTX_free(context);
 }
 
 static void
@@ -146,8 +146,7 @@ static void*
 create_context()
 {
     HMAC_CTX* context;
-    CHECKALLOC(context = (HMAC_CTX*) malloc(sizeof(HMAC_CTX)));
-    HMAC_CTX_init(context);
+    CHECKALLOC(context = HMAC_CTX_new());
     context_add_cleanup(context);
     return context;
 }

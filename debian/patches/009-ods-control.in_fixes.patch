--- opendnssec.orig/tools/ods-control.in
+++ opendnssec/tools/ods-control.in
@@ -38,11 +38,13 @@ case "$1" in
 'ksm')
 	shift
 	"$bindir/ods-ksmutil" $@
+	exit $?
 	;;
 
 'hsm')
 	shift
 	"$bindir/ods-hsmutil" $@
+	exit $?
 	;;
 
 'signer')
@@ -82,9 +84,15 @@ case "$1" in
 		
 		exit $RETVAL
 		;;
+	stop)
+		echo "Stopping signer engine.."

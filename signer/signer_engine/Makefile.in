installdirs:
	for dir in "$(DESTDIR)$(sbindir)" "$(DESTDIR)$(signerdir)" "$(DESTDIR)$(man8dir)"; do \
	  test -z "$$dir" || $(MKDIR_P) "$$dir"; \
	done

all: config.h
	$(MAKE) $(AM_MAKEFLAGS) all-am

.SUFFIXES:
.SUFFIXES: .c .lo .o .obj
$(srcdir)/Makefile.in:  $(srcdir)/Makefile.am  $(am__configure_deps)
	@for dep in $?; do \
	  case '$(am__configure_deps)' in \
	    *$$dep*) \
	      ( cd $(top_builddir) && $(MAKE) $(AM_MAKEFLAGS) am--refresh ) \
	        && { if test -f $@; then exit 0; else break; fi; }; \
	      exit 1;; \
	  esac; \
	done; \
	echo ' cd $(top_srcdir) && $(AUTOMAKE) --foreign  tools/Makefile'; \
	cd $(top_srcdir) && \
	  $(AUTOMAKE) --foreign  tools/Makefile
.PRECIOUS: Makefile
Makefile: $(srcdir)/Makefile.in $(top_builddir)/config.status
	@case '$?' in \
	  *config.status*) \
	    cd $(top_builddir) && $(MAKE) $(AM_MAKEFLAGS) am--refresh;; \
	  *) \
	    echo ' cd $(top_builddir) && $(SHELL) ./config.status $(subdir)/$@ $(am__depfiles_maybe)'; \
	    cd $(top_builddir) && $(SHELL) ./config.status $(subdir)/$@ $(am__depfiles_maybe);; \
	esac;

$(top_builddir)/config.status: $(top_srcdir)/configure $(CONFIG_STATUS_DEPENDENCIES)
	cd $(top_builddir) && $(MAKE) $(AM_MAKEFLAGS) am--refresh

$(top_srcdir)/configure:  $(am__configure_deps)
	cd $(top_builddir) && $(MAKE) $(AM_MAKEFLAGS) am--refresh
$(ACLOCAL_M4):  $(am__aclocal_m4_deps)
	cd $(top_builddir) && $(MAKE) $(AM_MAKEFLAGS) am--refresh

config.h: stamp-h1
	@if test ! -f $@; then \
	  rm -f stamp-h1; \
	  $(MAKE) $(AM_MAKEFLAGS) stamp-h1; \
	else :; fi

stamp-h1: $(srcdir)/config.h.in $(top_builddir)/config.status
	@rm -f stamp-h1
	cd $(top_builddir) && $(SHELL) ./config.status tools/config.h
$(srcdir)/config.h.in:  $(am__configure_deps) 
	cd $(top_srcdir) && $(AUTOHEADER)
	rm -f stamp-h1
	touch $@

distclean-hdr:
	-rm -f config.h stamp-h1
install-opendnsseclibexecPROGRAMS: $(opendnsseclibexec_PROGRAMS)
	@$(NORMAL_INSTALL)
	test -z "$(opendnsseclibexecdir)" || $(MKDIR_P) "$(DESTDIR)$(opendnsseclibexecdir)"
	@list='$(opendnsseclibexec_PROGRAMS)'; for p in $$list; do \
	  p1=`echo $$p|sed 's/$(EXEEXT)$$//'`; \
	  if test -f $$p \
	     || test -f $$p1 \
	  ; then \
	    f=`echo "$$p1" | sed 's,^.*/,,;$(transform);s/$$/$(EXEEXT)/'`; \
	   echo " $(INSTALL_PROGRAM_ENV) $(LIBTOOL) $(AM_LIBTOOLFLAGS) $(LIBTOOLFLAGS) --mode=install $(opendnsseclibexecPROGRAMS_INSTALL) '$$p' '$(DESTDIR)$(opendnsseclibexecdir)/$$f'"; \
	   $(INSTALL_PROGRAM_ENV) $(LIBTOOL) $(AM_LIBTOOLFLAGS) $(LIBTOOLFLAGS) --mode=install $(opendnsseclibexecPROGRAMS_INSTALL) "$$p" "$(DESTDIR)$(opendnsseclibexecdir)/$$f" || exit 1; \
	  else :; fi; \
	done

uninstall-opendnsseclibexecPROGRAMS:
	@$(NORMAL_UNINSTALL)
	@list='$(opendnsseclibexec_PROGRAMS)'; for p in $$list; do \
	  f=`echo "$$p" | sed 's,^.*/,,;s/$(EXEEXT)$$//;$(transform);s/$$/$(EXEEXT)/'`; \
	  echo " rm -f '$(DESTDIR)$(opendnsseclibexecdir)/$$f'"; \
	  rm -f "$(DESTDIR)$(opendnsseclibexecdir)/$$f"; \
	done

clean-opendnsseclibexecPROGRAMS:
	@list='$(opendnsseclibexec_PROGRAMS)'; for p in $$list; do \
	  f=`echo $$p|sed 's/$(EXEEXT)$$//'`; \
	  echo " rm -f $$p $$f"; \
	  rm -f $$p $$f ; \
	done
create_dnskey$(EXEEXT): $(create_dnskey_OBJECTS) $(create_dnskey_DEPENDENCIES) 
	@rm -f create_dnskey$(EXEEXT)
	$(LINK) $(create_dnskey_OBJECTS) $(create_dnskey_LDADD) $(LIBS)
finalizer$(EXEEXT): $(finalizer_OBJECTS) $(finalizer_DEPENDENCIES) 
	@rm -f finalizer$(EXEEXT)
	$(LINK) $(finalizer_OBJECTS) $(finalizer_LDADD) $(LIBS)
get_class$(EXEEXT): $(get_class_OBJECTS) $(get_class_DEPENDENCIES) 
	@rm -f get_class$(EXEEXT)
	$(LINK) $(get_class_OBJECTS) $(get_class_LDADD) $(LIBS)
get_serial$(EXEEXT): $(get_serial_OBJECTS) $(get_serial_DEPENDENCIES) 
	@rm -f get_serial$(EXEEXT)
	$(LINK) $(get_serial_OBJECTS) $(get_serial_LDADD) $(LIBS)
quicksorter$(EXEEXT): $(quicksorter_OBJECTS) $(quicksorter_DEPENDENCIES) 
	@rm -f quicksorter$(EXEEXT)
	$(quicksorter_LINK) $(quicksorter_OBJECTS) $(quicksorter_LDADD) $(LIBS)
signer$(EXEEXT): $(signer_OBJECTS) $(signer_DEPENDENCIES) 
	@rm -f signer$(EXEEXT)
	$(LINK) $(signer_OBJECTS) $(signer_LDADD) $(LIBS)
zone_fetcher$(EXEEXT): $(zone_fetcher_OBJECTS) $(zone_fetcher_DEPENDENCIES) 
	@rm -f zone_fetcher$(EXEEXT)
	$(LINK) $(zone_fetcher_OBJECTS) $(zone_fetcher_LDADD) $(LIBS)
zone_reader$(EXEEXT): $(zone_reader_OBJECTS) $(zone_reader_DEPENDENCIES) 
	@rm -f zone_reader$(EXEEXT)
	$(LINK) $(zone_reader_OBJECTS) $(zone_reader_LDADD) $(LIBS)

mostlyclean-compile:
	-rm -f *.$(OBJEXT)

distclean-compile:
	-rm -f *.tab.c

